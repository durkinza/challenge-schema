{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://json.schemastore.org/ctf-challenge-pack.schema.json",
  "title": "CTF Challenge Pack",
  "version": "0.0.0",
  "description": "A pack of Cyber Security Capture the Flag (CTF) challenges.",
  "type": "object",
  "properties": {
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "description": "The location of the challenge bundle",
            "examples": [
              "./challenge-1",
              "/home/bob/challenges/challenge-1"
            ],
            "type": "string"
          },
          "id": {
            "description": "The unique identifier for the challenge bundle",
            "examples": [
              "challenge-1",
              "challenge-2"
            ],
            "type": "string"
          },
          "category": {
            "description": "The category of the challenge. If not provided, it will default to the category in the challenge.",
            "examples": [
              "web",
              "crypto",
              "forensics"
            ],
            "type": "string"
          },
          "points": {
            "description": "The score/value/points of the challenge. If not provided, it will default to the points value from the challenge.",
            "examples": [
              1,
              20,
              300
            ],
            "type": "number"
          },
          "prerequisites": {
            "description": "The prerequisites of other challenges that must be solved before this challenge",
            "examples": [
              [
                "challenge-1",
                "challenge-2"
              ]
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "path",
          "id"
        ]
      }
    }
  },
  "required": [
    "challenges"
  ]
}