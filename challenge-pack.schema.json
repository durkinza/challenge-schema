{
  "type": "object",
  "properties": {
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "The unique identifier for the challenge bundle",
            "examples": [
              "challenge-1",
              "challenge-2"
            ],
            "type": "string"
          },
          "slug": {
            "description": "The short name for the challenge. Useful when the ID is a UUID.",
            "examples": [
              "challenge-1",
              "challenge-2"
            ],
            "type": "string"
          },
          "category": {
            "description": "The category of the challenge",
            "examples": [
              "web",
              "crypto",
              "forensics"
            ],
            "type": "string"
          },
          "value": {
            "description": "The score/value of the challenge",
            "examples": [
              1,
              20,
              300
            ],
            "type": "number"
          },
          "prerequisites": {
            "description": "The prerequisites of other challenges that must be solved before this challenge",
            "examples": [
              [
                "challenge-1",
                "challenge-2"
              ]
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "category",
          "value"
        ]
      }
    }
  },
  "required": [
    "challenges"
  ]
}