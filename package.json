{
    "name": "@durkinza/challenge-schema",
    "version": "0.1.0",
    "description": "A schema for sharing CTF Challenges in a portable bundle.",
    "main": "dist/index.js",
    "types": "dist/src/index.d.ts",
    "module": "dist/index.js",
    "bin": {
        "challenge-schema": "dist/cli.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/durkinza/challenge-bundle-schema"
    },
    "packageManager": "^bun@1.2.12",
    "scripts": {
        "check": "bun run check:format && bun run check:lint && bun run check:types",
        "check:format": "prettier --check --ignore-unknown ./src",
        "check:lint": "eslint . --ext .ts,.tsx",
        "check:types": "tsc --noEmit",
        "fix": "bun run fix:format && bun run fix:lint",
        "fix:format": "prettier --check --ignore-unknown ./src --write",
        "fix:lint": "eslint . --ext .ts,.tsx,.md --fix",
        "test": "bun test && bun run test:spelling",
        "test:unit": "bun test unit.test",
        "test:int": "bun test int.test",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --coverage",
        "test:spelling": "bunx cspell './**/*.{ts,tsx,js,jsx,json,md,yml,yaml}'",
        "build": "bun run build:dist  && bun run build:tsc && bun run build:json-schema",
        "build:dist": "bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target='node' --sourcemap='linked' --packages=external --minify",
        "build:tsc": "tsc --project tsconfig.dts.json --outDir ./dist",
        "build:json-schema": "bun ./scripts/build-json-schema.ts",
        "docs:generate": "mkdocs build -f ./docs/mkdocs.yml --clean",
        "docs:serve": "mkdocs serve -w ./docs/docs/ -f ./docs/mkdocs.yml",
        "prepare": "husky"
    },
    "dependencies": {
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^9.39.2",
        "@eslint/markdown": "^7.5.1",
        "@typescript-eslint/eslint-plugin": "^8.50.1",
        "@typescript-eslint/parser": "^8.50.1",
        "@types/bun": "^1.3.5",
        "bun-plugin-dts": "^0.3.0",
        "bun-types": "^1.3.5",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "prettier": "^3.7.4",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2"
    },
    "files": [
        "LICENSE",
        "README.md",
        "dist",
        "challenge.schema.json",
        "challenge-pack.schema.json"
    ],
    "keywords": [
        "ctf",
        "challenge",
        "ctf-challenge",
        "ctf-challenges",
        "challenge-pack",
        "ctf-challenge-pack",
        "ctf-challenge-packs",
        "ctf-bundle",
        "ctf-bundles",
        "challenge-bundle",
        "schema",
        "json-schema"
    ]
}