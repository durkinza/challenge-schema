{
    "name": "@durkinza/challenge-schema",
    "version": "0.0.1",
    "description": "A schema for sharing CTF Challenges in a portable bundle.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "module": "dist/index.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/durkinza/challenge-bundle-schema"
    },
    "packageManager": "^bun@1.2.12",
    "scripts": {
        "check": "bun run check:format && bun run check:lint && bun run check:types",
        "check:format": "prettier --check --ignore-unknown ./src",
        "check:lint": "eslint . --ext .ts,.tsx",
        "check:types": "tsc --noEmit",
        "fix": "bun run fix:format && bun run fix:lint",
        "fix:format": "prettier --check --ignore-unknown ./src --write",
        "fix:lint": "eslint . --ext .ts,.tsx --fix",
        "test": "bun test",
        "test:unit": "bun test unit.test",
        "test:int": "bun test int.test",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --coverage",
        "build": "bun run build:dist && bun run build:json-schema",
        "build:dist": "bun build ./src/index.ts --outdir ./dist --target='node' --sourcemap='linked' --packages=external --minify",
        "build:json-schema": "bun ./scripts/build-json-schema.ts",
        "prepare": "husky"
    },
    "dependencies": {
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.26.0",
        "@types/node": "^22.15.17",
        "@typescript-eslint/eslint-plugin": "^8.32.0",
        "@typescript-eslint/parser": "^8.32.0",
        "eslint": "^9.26.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "prettier": "^3.5.3",
        "ts-jest": "^29.3.2",
        "ts-node": "^10.9.2"
    },
    "files": [
        "LICENSE", 
        "README.md",
        "dist",
        "challenge.schema.json",
        "challenge-pack.schema.json"
    ],
    "keywords": [
        "ctf",
        "challenge",
        "ctf-challenge",
        "ctf-challenges",
        "challenge-pack",
        "ctf-challenge-pack",
        "ctf-challenge-packs",
        "ctf-bundle",
        "ctf-bundles",
        "challenge-bundle",
        "schema",
        "json-schema"
    ]
}
