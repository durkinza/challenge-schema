{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "baseUrl": "./src",
        "paths": {
            "@challenge-bundle": [
                "./challenge-schema"
            ],
            "@challenge-bundle/*": [
                "./challenge-schema/*"
            ],
            "@challenge-pack": [
                "./challenge-pack-schema"
            ],
            "@challenge-pack/*": [
                "./challenge-pack-schema/*"
            ]
        },
    },
    "exclude": [
        "jest.config.ts",
        "tests",
        "dist",
        "docs",
        "scripts",
        "node_modules"
    ]
}