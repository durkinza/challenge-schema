{
    "$schema": "../../../challenge.schema.json",
    "name": "Caesar Cipher",
    "description": "A simple Caesar cipher challenge. The flag is hidden in the text.",
    "points": 0,
    "category": "web",
    "customFlag": {
        "allowedCharacters": {
            "lowercase": true,
            "uppercase": false,
            "numbers": false,
            "specialCharacters": false
        },
        "length": {
            "max": 4000
        }
    },
    "defaultFlag": {
        "regex": [
            "/(flag)?{?caesar_salad}?/i"
        ],
        "static": [
            "flag{caesar_salad}",
            "caesar_salad"
        ]
    },
    "deployment": {
        "type": "standard",
        "standard": {
            "build": {
                "buildType": "script",
                "script": {
                    "path": "build.sh",
                    "outputs": [
                        {
                            "key": "cipher.txt",
                            "path": "cipher.txt"
                        }
                    ],
                    "parameters": {
                        "arguments": [
                            {
                                "key": "--flag",
                                "description": "The flag to be used in the challenge"
                            }
                        ],
                        "environmentVariables": [
                            {
                                "key": "ROTATION_KEY",
                                "description": "Accepts the number of rotations to use in the Caesar cipher. Defaults to 13."
                            }
                        ],
                        "flagArgumentName": "--flag"
                    }
                }
            },
            "attachments": [
                {
                    "name": "Cipher.txt",
                    "type": "text/plain",
                    "key": "cipher.txt"
                }
            ]
        }
    },
    "author": {
        "name": "NeverLANCTF",
        "email": "info@neverlanctf.org",
        "website": "https://neverlanctf.org"
    },
    "language": "english",
    "solutions": [
        "Open the cipher.txt file",
        "Decrypt the text using a Caesar cipher with a shift of 13"
    ]
}