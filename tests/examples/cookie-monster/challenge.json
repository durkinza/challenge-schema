{
    "$schema": "../../../challenge.schema.json",
    "name": "Cookie-Monster",
    "description": "There's trouble on Seasame Street! The Cookie Monster needs your help to find his cookies!",
    "defaultFlag": {
        "static": [
            "flag{C00kies_4r3_the_b3st}"
        ],
        "regex": [
            "/(flag)?{?C00kies_4r3_the_b3st}?/i"
        ]
    },
    "customFlag": {
        "allowedCharacters": {
            "lowercase": true,
            "uppercase": true,
            "numbers": true,
            "specialCharacters": true
        }
    },
    "points": 100,
    "category": "web",
    "deployment": {
        "type": "hosted",
        "hosted": {
            "container": {
                "image": "neverlanctf/cookie-monster:lastest",
                "driver": "docker",
                "ports": [
                    {
                        "port": 80,
                        "protocol": "http"
                    }
                ],
                "resourceRequirements": {
                    "cpu": 1024,
                    "memory": "256Mi"
                },
                "parameters": {
                    "environmentVariables": [
                        {
                            "key": "FLAG",
                            "description": "The flag to be used in the challenge"
                        }
                    ],
                    "flagEnvironmentVariableName": "FLAG"
                }
            }
        }
    },
    "author": {
        "name": "NeverLANCTF",
        "email": "info@neverlanctf.org",
        "website": "https://neverlanctf.org"
    },
    "hints": [
        {
            "id": 1,
            "title": "Using your browser",
            "hint": "Use your browser's developer tools to inspect cookies.",
            "cost": 10
        },
        {
            "id": 2,
            "title": "Who is the Cookie Monster?",
            "hint": "The Cookie Monster is a character on the show Seasame Street. His friend Elmo is Red.",
            "requirements": [
                1
            ]
        }
    ],
    "language": "english",
    "solutions": [
        "Load the page the first time",
        "Look for a cookie in your browser that is called `Red_Guy's_name` and change the value to 'Elmo'",
        "Reload the page to submit the new cookie and obtain the flag"
    ]
}