{
  "id": "ctf-challenge-bundle",
  "title": "CTF Challenge Bundle",
  "version": "0.0.0",
  "description": "A bundle of information about a challenge, including its name, description, default flag, custom flag, deployment, author, language, and solutions.",
  "type": "object",
  "properties": {
    "name": {
      "description": "The name of the challenge",
      "type": "string"
    },
    "description": {
      "description": "A short description of the challenge.",
      "type": "string"
    },
    "defaultFlag": {
      "description": "The default flag for this challenge. Default: The challenge has no default flag.",
      "type": "object",
      "properties": {
        "value": {
          "description": "The default flag for the challenge",
          "examples": [
            "flag{this_is_a_flag}"
          ],
          "type": "string"
        },
        "regex": {
          "description": "the regex value for finding the flag",
          "examples": [
            "/(flag)?{?this_is_a_flag}?/i"
          ],
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "customFlag": {
      "description": "How to provide a custom flag for the challenge when producing a dynamic flag, or undefined if dynamic flags are not supported.",
      "type": "object",
      "properties": {
        "allowedCharacters": {
          "anyOf": [
            {
              "description": "An object of allowed characters or a regex string that it must match",
              "type": "object",
              "properties": {
                "lowercase": {
                  "description": "If lowercase characters are allowed in the flag.",
                  "type": "boolean"
                },
                "uppercase": {
                  "description": "If uppercase characters are allowed in the flag.",
                  "type": "boolean"
                },
                "numbers": {
                  "description": "If numbers characters are allowed in the flag.",
                  "type": "boolean"
                },
                "specialCharacters": {
                  "description": "If special characters are allowed in the flag.",
                  "type": "boolean"
                },
                "length": {
                  "description": "The length of the flag. Default: infinite length.",
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "min": {
                          "description": "The minimum length of the flag",
                          "type": "number"
                        },
                        "max": {
                          "description": "The maximum length of the flag",
                          "type": "number"
                        }
                      },
                      "required": [
                        "min",
                        "max"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "lowercase",
                "uppercase",
                "numbers",
                "specialCharacters"
              ]
            },
            {
              "description": "A Regex string that the flag must match to work.",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "allowedCharacters"
      ]
    },
    "deployment": {
      "description": "How the challenge should be deployed. Either 'hosted' or 'standard', but not both.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "hosted"
            },
            "hosted": {
              "description": "Configuration for challenges that require a hosted container",
              "type": "object",
              "properties": {
                "container": {
                  "type": "object",
                  "properties": {
                    "image": {
                      "description": "The image name to use for the challenge.",
                      "examples": [
                        "neverlanctf/cookie-monster:latest"
                      ],
                      "type": "string"
                    },
                    "imageTar": {
                      "description": "The tar file containing the challenge image"
                    },
                    "driver": {
                      "description": "The hosting driver to use for the challenge, e.g. 'docker', 'podman', 'containerd', 'vmware', 'kvm', 'lxc', 'kubernetes'",
                      "type": "string"
                    },
                    "resourceRequirements": {
                      "description": "The minimum resources the container requires",
                      "type": "object",
                      "properties": {
                        "cpu": {
                          "description": "The minimum CPU required for the challenge, e.g. 1024",
                          "type": "number"
                        },
                        "memory": {
                          "description": "The minimum memory required for the challenge, e.g. '256Mi'",
                          "type": "string"
                        },
                        "disk": {
                          "description": "The minimum disk required for the challenge, e.g. '1Gi'",
                          "type": "string"
                        },
                        "gpu": {
                          "description": "The minimum GPU required for the challenge, e.g. 0.5",
                          "type": "number"
                        }
                      },
                      "required": []
                    },
                    "ports": {
                      "description": "The ports to expose for the challenge",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "port": {
                            "description": "The port to expose for the challenge, e.g. 80, 443, 22",
                            "type": "number"
                          },
                          "protocol": {
                            "description": "The protocol to expect for the port, e.g. 'tcp', 'udp', 'http'",
                            "type": "string"
                          }
                        },
                        "required": [
                          "port",
                          "protocol"
                        ]
                      }
                    },
                    "flagArg": {
                      "description": "The argument to pass to the container, e.g. '--flag flag{this_is_a_flag}'",
                      "type": "string"
                    },
                    "outputs": {
                      "description": "The attachment outputs from the container.",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "description": "The key/name of the output to be referenced in the attachment step",
                            "type": "string"
                          },
                          "path": {
                            "description": "The path to the file in the container, e.g. '/tmp/artifact.zip'",
                            "type": "string"
                          }
                        },
                        "required": [
                          "key",
                          "path"
                        ]
                      }
                    }
                  },
                  "required": [
                    "image",
                    "driver",
                    "ports"
                  ]
                },
                "stack": {
                  "type": "object",
                  "properties": {
                    "driver": {
                      "description": "The hosting driver to use for the challenge, e.g. 'docker-compose', 'kubernetes', 'vmware', 'ESXi'",
                      "type": "string"
                    },
                    "composeFile": {
                      "description": "The docker-compose file to use for the challenge",
                      "type": "string"
                    }
                  },
                  "required": [
                    "driver",
                    "composeFile"
                  ]
                },
                "attachments": {
                  "description": "Attachments must be a local file, URL, a file from the build step, or a raw string",
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "description": "An attachment provided as a file to the player.",
                        "type": "object",
                        "properties": {
                          "name": {
                            "description": "The name of the file, e.g. 'artifact.zip'",
                            "type": "string"
                          },
                          "type": {
                            "description": "The type of the file, e.g. 'application/zip', 'image/png', 'text/plain'",
                            "type": "string"
                          },
                          "path": {
                            "description": "The path to the file, e.g. '/tmp/artifact.zip'",
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "type"
                        ]
                      },
                      {
                        "description": "An attachment provided from the output of a container to the player.",
                        "type": "object",
                        "properties": {
                          "name": {
                            "description": "The name of the file, e.g. 'artifact.zip'",
                            "type": "string"
                          },
                          "type": {
                            "description": "The type of the file, e.g. 'application/zip', 'image/png', 'text/plain'",
                            "type": "string"
                          },
                          "key": {
                            "description": "The key/name of the file to be used in the attachment step",
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "type",
                          "key"
                        ]
                      },
                      {
                        "description": "An attachment provided as a URL to the player.",
                        "type": "object",
                        "properties": {
                          "name": {
                            "description": "The name of the file, e.g. 'artifact.zip'",
                            "type": "string"
                          },
                          "type": {
                            "description": "The type of the file, e.g. 'application/zip', 'image/png', 'text/plain'",
                            "type": "string"
                          },
                          "url": {
                            "description": "The URL of the file, e.g. 'https://example.com/artifact.zip'",
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "type"
                        ]
                      },
                      {
                        "description": "An attachment provided as text to the player.",
                        "type": "object",
                        "properties": {
                          "name": {
                            "description": "The name of the file, e.g. 'artifact.zip'",
                            "type": "string"
                          },
                          "type": {
                            "description": "The type of the file, e.g. 'application/zip', 'image/png', 'text/plain'",
                            "type": "string"
                          },
                          "content": {
                            "description": "The raw content of the attachment, e.g. 'Hello World'",
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "type"
                        ]
                      }
                    ]
                  }
                }
              },
              "required": []
            }
          },
          "required": [
            "type",
            "hosted"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "standard"
            },
            "standard": {
              "description": "Configuration for challenges that do not require a hosted container",
              "type": "object",
              "properties": {
                "build": {
                  "description": "How to build the challenge, only required if dynamic flags are supported",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "buildType": {
                          "const": "script"
                        },
                        "script": {
                          "type": "object",
                          "properties": {
                            "path": {
                              "description": "The path to the script to run, e.g. '/tmp/build.sh'",
                              "type": "string"
                            },
                            "flagArg": {
                              "description": "The argument to pass to the script, e.x. 'flag' == '--flag flag{this_is_a_flag}'",
                              "type": "string"
                            },
                            "outputs": {
                              "description": "The outputs of the build process",
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "key": {
                                    "description": "The key/name of the output to be referenced in the attachment step",
                                    "type": "string"
                                  },
                                  "path": {
                                    "description": "The path to the file in the container, e.g. '/tmp/artifact.zip'",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "key",
                                  "path"
                                ]
                              }
                            }
                          },
                          "required": [
                            "path",
                            "flagArg"
                          ]
                        }
                      },
                      "required": [
                        "buildType",
                        "script"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "buildType": {
                          "const": "container"
                        },
                        "container": {
                          "type": "object",
                          "properties": {
                            "image": {
                              "description": "The image name to use for the challenge.",
                              "examples": [
                                "neverlanctf/cookie-monster:latest"
                              ],
                              "type": "string"
                            },
                            "imageTar": {
                              "description": "The tar file containing the challenge image"
                            },
                            "driver": {
                              "description": "The hosting driver to use for the challenge, e.g. 'docker', 'podman', 'containerd', 'vmware', 'kvm', 'lxc', 'kubernetes'",
                              "type": "string"
                            },
                            "resourceRequirements": {
                              "description": "The minimum resources the container requires",
                              "type": "object",
                              "properties": {
                                "cpu": {
                                  "description": "The minimum CPU required for the challenge, e.g. 1024",
                                  "type": "number"
                                },
                                "memory": {
                                  "description": "The minimum memory required for the challenge, e.g. '256Mi'",
                                  "type": "string"
                                },
                                "disk": {
                                  "description": "The minimum disk required for the challenge, e.g. '1Gi'",
                                  "type": "string"
                                },
                                "gpu": {
                                  "description": "The minimum GPU required for the challenge, e.g. 0.5",
                                  "type": "number"
                                }
                              },
                              "required": []
                            },
                            "flagArg": {
                              "description": "The argument to pass to the container, e.g. '--flag flag{this_is_a_flag}'",
                              "type": "string"
                            },
                            "outputs": {
                              "description": "The attachment outputs from the container.",
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "key": {
                                    "description": "The key/name of the output to be referenced in the attachment step",
                                    "type": "string"
                                  },
                                  "path": {
                                    "description": "The path to the file in the container, e.g. '/tmp/artifact.zip'",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "key",
                                  "path"
                                ]
                              }
                            }
                          },
                          "required": [
                            "image",
                            "driver"
                          ]
                        }
                      },
                      "required": [
                        "buildType",
                        "container"
                      ]
                    }
                  ]
                },
                "attachments": {
                  "description": "Attachments must be a local file, URL, a file from the build step, or a raw string",
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "description": "An attachment provided as a file to the player.",
                        "type": "object",
                        "properties": {
                          "name": {
                            "description": "The name of the file, e.g. 'artifact.zip'",
                            "type": "string"
                          },
                          "type": {
                            "description": "The type of the file, e.g. 'application/zip', 'image/png', 'text/plain'",
                            "type": "string"
                          },
                          "path": {
                            "description": "The path to the file, e.g. '/tmp/artifact.zip'",
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "type"
                        ]
                      },
                      {
                        "description": "An attachment provided from the output of a container to the player.",
                        "type": "object",
                        "properties": {
                          "name": {
                            "description": "The name of the file, e.g. 'artifact.zip'",
                            "type": "string"
                          },
                          "type": {
                            "description": "The type of the file, e.g. 'application/zip', 'image/png', 'text/plain'",
                            "type": "string"
                          },
                          "key": {
                            "description": "The key/name of the file to be used in the attachment step",
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "type",
                          "key"
                        ]
                      },
                      {
                        "description": "An attachment provided as a URL to the player.",
                        "type": "object",
                        "properties": {
                          "name": {
                            "description": "The name of the file, e.g. 'artifact.zip'",
                            "type": "string"
                          },
                          "type": {
                            "description": "The type of the file, e.g. 'application/zip', 'image/png', 'text/plain'",
                            "type": "string"
                          },
                          "url": {
                            "description": "The URL of the file, e.g. 'https://example.com/artifact.zip'",
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "type"
                        ]
                      },
                      {
                        "description": "An attachment provided as text to the player.",
                        "type": "object",
                        "properties": {
                          "name": {
                            "description": "The name of the file, e.g. 'artifact.zip'",
                            "type": "string"
                          },
                          "type": {
                            "description": "The type of the file, e.g. 'application/zip', 'image/png', 'text/plain'",
                            "type": "string"
                          },
                          "content": {
                            "description": "The raw content of the attachment, e.g. 'Hello World'",
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "type"
                        ]
                      }
                    ]
                  }
                }
              },
              "required": [
                "attachments"
              ]
            }
          },
          "required": [
            "type",
            "standard"
          ]
        }
      ]
    },
    "author": {
      "description": "The author of the challenge, which may be different than the user who published the challenge",
      "type": "object",
      "properties": {
        "name": {
          "description": "The author's name",
          "type": "string"
        },
        "email": {
          "description": "The author's email",
          "type": "string"
        },
        "website": {
          "description": "The author's website",
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "language": {
      "description": "The language used to create the challenge.",
      "examples": [
        "English",
        "French",
        "Spanish"
      ],
      "type": "string"
    },
    "solutions": {
      "description": "A short write-up of how to solve the challenge for the event coordinators",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "deployment",
    "author",
    "language",
    "solutions"
  ]
}